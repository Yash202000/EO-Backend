# Copy to .env.docker (git-ignored) and fill in. Read by the backend container only,
# on top of .env. Generate keys with: openssl rand -hex 32
#
# Required for the dev licence seeder (APP_ENV=development). Without it most API routes
# answer "license required".
LICENSE_ENCRYPTION_KEY=

# Use a long random value; overrides the one in .env.
JWT_SECRET=

# Token lifetimes for local use (the .env values are set very short for testing)
JWT_EXPIRE_HOUR=8
JWT_REFRESH_EXPIRE_HOUR=24
JWT_REMEMBER_EXPIRE_HOUR=168

# Optional: push notifications. Mount the file in docker-compose.yml, then:
# FIREBASE_CREDENTIAL_PATH=/app/secrets/firebase.json
